<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="LGXT Assistant" Language="2052" Codepage="936" Version="3.1.0.0"
           Manufacturer="Styayur"
           UpgradeCode="0D5655EF-2FE6-48ED-9EA7-D0892E7C7AB1">
    <Package Id="*" InstallerVersion="500" Compressed="yes"
             InstallScope="perUser" InstallPrivileges="limited"
             Description="LGXT Assistant - 理工学堂助手"
             Comments="GPL-3.0-or-later · Styayur" />

    <MajorUpgrade DowngradeErrorMessage="已安装更高版本的 LGXT Assistant，请先卸载。" />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/styayur/LGXT-Assistant-3.0" />
    <Property Id="ARPCOMMENTS" Value="理工学堂助手 · 宇宙星链 · GPL-3.0-or-later" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="LGXT Assistant" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="LGXT Assistant" />
      </Directory>
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="3531F849-ACE5-440B-A275-F0D608C9F00F">
        <Shortcut Id="StartMenuShortcut" Name="LGXT Assistant"
                  Description="理工学堂助手 · 宇宙星链"
                  Target="[INSTALLFOLDER]LGXT-Assistant-portable.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Styayur\LGXT Assistant"
                       Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="LGXT Assistant" Level="1" Display="expand">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Product>
</Wix>
